{
  "buildCommand": "npx next build",
  "functions": {
    "app/api/bagua/completion/route.ts": { "maxDuration": 60 },
    "app/api/interpret/route.ts": { "maxDuration": 60 },
    "app/api/pdf/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
