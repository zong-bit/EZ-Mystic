{
  "buildCommand": "npx next build",
  "functions": {
    "app/api/bagua/completion/route.ts": { "maxDuration": 60 },
    "app/api/interpret/route.ts": { "maxDuration": 60 },
    "app/api/pdf/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/bagua(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
